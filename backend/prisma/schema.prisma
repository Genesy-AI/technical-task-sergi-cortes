generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  /// Copy of the current role's job title, kept in sync on import.
  jobTitle    String?
  countryCode String?
  /// Copy of the current role's company, kept in sync on import.
  companyName String?
  message     String?
  emailVerificationStatus EmailVerificationStatus @default(UNVERIFIED)
  /// Cleaned phone text with an optional extension, such as `(731)123-9702`.
  phone       String?
  /// Canonical `https://www.linkedin.com/in/<slug>` profile URL.
  linkedinUrl String?
  roles       leadRole[]
  /// Where the current phone came from.
  phoneSource PhoneSource?
  phoneEnrichmentStatus PhoneEnrichmentStatus @default(NOT_STARTED)
  /// `{ provider, position, total }` while a lookup is trying a provider; null otherwise.
  phoneEnrichmentProgress Json?
  /// What each provider did in the last lookup: skipped with a reason, not found, errored, or found.
  phoneEnrichmentAttempts Json?
  /// When the last lookup ended.
  phoneEnrichedAt DateTime?
}

enum PhoneSource {
  IMPORT
  ASTRA
  NIMBUS
  ORION
}

/// A lead's phone lookup ends in FOUND, NOT_FOUND, or FAILED once it starts.
enum PhoneEnrichmentStatus {
  NOT_STARTED
  PENDING
  FOUND
  NOT_FOUND
  FAILED
}

/// One role a lead has held, in file order; exactly one per lead is current.
model leadRole {
  id          Int      @id @default(autoincrement())
  leadId      Int
  lead        lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// 0-based order in which the roles appeared in the import file.
  position    Int
  jobTitle    String?
  companyName String?
  /// Whole years in this role, from 0 to 80.
  yearsInRole Int?
  isCurrent   Boolean  @default(false)

  @@unique([leadId, position])
}

/// Every lead's email ends in exactly one of these after verification starts.
enum EmailVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  INVALID
  FAILED
}
