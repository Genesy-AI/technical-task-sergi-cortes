generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  message     String?
  emailVerificationStatus EmailVerificationStatus @default(UNVERIFIED)
}

/// Every lead's email ends in exactly one of these after verification starts.
enum EmailVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  INVALID
  FAILED
}
