# Copy this file to backend/.env, which is gitignored, and replace every "changeme".
# The backend loads backend/.env at startup; variables already set in the shell take precedence.
# The database is the local SQLite file configured in prisma/schema.prisma, so it needs no variable here.

# Phone enrichment provider keys. Each provider in PHONE_PROVIDER_ORDER needs its key,
# and the phone enrichment workers refuse to start, naming the variable, when one is missing.
ASTRA_API_KEY=changeme
NIMBUS_API_KEY=changeme
ORION_API_KEY=changeme

# Optional: the providers to try, in order. Leave a provider out to switch it off.
# PHONE_PROVIDER_ORDER=ASTRA,NIMBUS,ORION

# Optional: endpoint overrides. These defaults are the documented endpoints.
# ASTRA_BASE_URL=https://api.enginy.ai/api/tmp/astraDialer
# NIMBUS_BASE_URL=https://api.enginy.ai/api/tmp/numbusLookup
# ORION_BASE_URL=https://api.enginy.ai/api/tmp/orionConnect

# Optional: calls per second per provider, enforced by Temporal across all workers. Unset means unlimited.
# PHONE_ASTRA_MAX_PER_SECOND=5
# PHONE_NIMBUS_MAX_PER_SECOND=5
# PHONE_ORION_MAX_PER_SECOND=1

# Optional: Temporal connection, defaulting to the local dev server.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=myQueue
