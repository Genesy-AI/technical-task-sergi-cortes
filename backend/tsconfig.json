{
  "compilerOptions": {
    "target": "es6",

    "module": "commonjs",
    "rootDir": "./src",
    "moduleResolution": "node",
    "baseUrl": "./",

    "outDir": "./dist",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "skipLibCheck": true
  },
  "exclude": ["vitest.config.ts", "src/**/*.test.ts", "src/test/**"]
}
